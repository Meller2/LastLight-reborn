+static void color_masked(vka_img *im, VkFormat fmt, uint32_t lv, uint32_t l0, uint32_t nl, VkRect2D rc, uint32_t mask, int is_int, const VkClearColorValue *val) {
+    VkPipeline p = cmc_pipeline(fmt, im->samples, mask, is_int);
+    if (!p || !(im->usage & VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT)) { VRED_ONCE("color clear with channel mask %#x: no pipeline, skipped", mask); return; }
+    uint32_t w, h; level_size(im, lv, &w, &h);
+    uint32_t pc[12] = {0};
+    pc[8] = val->uint32[0]; pc[9] = val->uint32[1]; pc[10] = val->uint32[2]; pc[11] = val->uint32[3];
+    for (uint32_t l = l0; l < l0 + nl; l++) {
+        VkImageView view = vka_view(im, fmt, VK_IMAGE_VIEW_TYPE_2D, VK_IMAGE_ASPECT_COLOR_BIT, lv, 1, l, 1, NULL);
+        if (!view) return;
+        VkRenderingAttachmentInfo a = {VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO, .imageView = view, .imageLayout = VK_IMAGE_LAYOUT_GENERAL, .loadOp = VK_ATTACHMENT_LOAD_OP_LOAD, .storeOp = VK_ATTACHMENT_STORE_OP_STORE};
+        VkRenderingInfo ri = {VK_STRUCTURE_TYPE_RENDERING_INFO, .renderArea = {{0, 0}, {w, h}}, .layerCount = 1, .colorAttachmentCount = 1, .pColorAttachments = &a};
+        vk.vkCmdBeginRendering(g_cb, &ri);
+        VkViewport v = {0, 0, (float)w, (float)h, 0, 1};
+        vk.vkCmdBindPipeline(g_cb, VK_PIPELINE_BIND_POINT_GRAPHICS, p);
+        vk.vkCmdPushConstants(g_cb, g_cmc_lay, VK_SHADER_STAGE_VERTEX_BIT | VK_SHADER_STAGE_FRAGMENT_BIT, 0, sizeof pc, pc);
+        vk.vkCmdSetViewport(g_cb, 0, 1, &v); vk.vkCmdSetScissor(g_cb, 0, 1, &rc);
+        vk.vkCmdDraw(g_cb, 3, 1, 0, 0);
+        vk.vkCmdEndRendering(g_cb);
+    }
+    vka_dyn_invalidate();
